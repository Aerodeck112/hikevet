# HiKeVet Next: reguli Apache / LiteSpeed pentru directorul public.
Options -Indexes
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Antete transmise aplicatiei
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Fisierele ascunse (.env, .git) nu se servesc niciodata; .well-known ramane pentru certificatul SSL.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # In directorul de incarcari nu se executa niciun script.
    RewriteRule ^uploads/.*\.(php\d?|phtml|phar|pl|py|cgi|sh)$ - [F,L,NC]

    # ATENTIE: regula implicita Laravel care elimina slash-ul final lipseste intentionat.
    # Adresele publice pastreaza forma din WordPress, cu slash la sfarsit (/servicii/);
    # forma canonica este stabilita in aplicatie (PublicRedirects). Cu ambele reguli ar rezulta o bucla.

    # Tot ce nu este fisier sau director real ajunge la aplicatie.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Cache lung doar pentru fisierele cu amprenta in nume si pentru imaginile optimizate.
<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|woff2|webp|svg|png|jpg|jpeg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <If "%{REQUEST_URI} =~ m#^/build/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
